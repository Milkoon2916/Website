<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 16mm 14mm 18mm 14mm; }
  :root{
    --paper:#F7F7F5; --card:#FFFFFF; --ink:#1F2123; --ink-soft:#6B6E73;
    --rule:#E3E2DE; --pink:#4B4D52; --pink-dark:#26272A; --pink-pale:#EDECE9;
  }
  *{ box-sizing:border-box; }
  body{
    margin:0; color:var(--ink);
    font-family:"NanumGothic","Nanum Gothic","Noto Sans CJK KR",sans-serif;
    font-size:11px; line-height:1.6;
  }
  .doc-header{ margin-bottom:16px; border-bottom:2px solid var(--pink); padding-bottom:10px; }
  .eyebrow{
    font-family:"IBM Plex Mono","Noto Sans Mono",monospace;
    font-size:9px; letter-spacing:.12em; text-transform:uppercase;
    color:var(--pink-dark); font-weight:700; margin:0 0 4px;
  }
  h1{ font-size:22px; font-weight:900; margin:0 0 4px; letter-spacing:-.01em; }
  .subtitle{ font-size:11px; color:var(--ink-soft); margin:0; }

  .word-card{
    background:var(--card); border:1.2px solid var(--rule); border-left:4px solid var(--pink);
    border-radius:8px; padding:14px 16px; margin-bottom:11px;
    page-break-inside:avoid; break-inside:avoid;
  }
  .word-header{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }
  .number{
    font-family:"IBM Plex Mono","Noto Sans Mono",monospace; font-size:9px; color:var(--ink-soft);
    display:block; letter-spacing:.05em; margin-bottom:2px;
  }
  .word-header h2{ font-size:16px; margin:0; font-weight:900; color:var(--ink); display:inline-block; }
  .badge{
    font-family:"IBM Plex Mono","Noto Sans Mono",monospace; font-size:8.5px; font-weight:700;
    letter-spacing:.03em; border:1.2px solid var(--pink); color:var(--pink-dark);
    background:var(--pink-pale); padding:3px 8px; border-radius:12px; white-space:nowrap;
  }
  .definition{ margin:8px 0 10px; font-size:12px; line-height:1.6; }
  .grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px 14px; margin-bottom:10px; }
  .grid div span{
    font-family:"IBM Plex Mono","Noto Sans Mono",monospace; font-size:8px; letter-spacing:.05em;
    text-transform:uppercase; color:var(--pink-dark); display:block; margin-bottom:2px; font-weight:700;
  }
  .grid div p{ margin:0; font-size:10.5px; line-height:1.5; }
  .sentence{
    background:var(--pink-pale); border-left:3px solid var(--pink); border-radius:0 6px 6px 0;
    padding:8px 12px; font-size:10.5px; line-height:1.6; margin-bottom:8px;
  }
  .sentence b{
    font-family:"IBM Plex Mono","Noto Sans Mono",monospace; font-size:8px; color:var(--pink-dark);
    text-transform:uppercase; letter-spacing:.05em; display:block; margin-bottom:3px; font-weight:700;
  }
  .context{ font-size:10px; color:var(--ink-soft); margin:0; line-height:1.5; }
</style>
</head>
<body>
  <div class="doc-header">
    <p class="eyebrow">ARA Vocab AI</p>
    <h1>ARA VOCABULARY</h1>
    <p class="subtitle">{{ title }} &middot; {{ level }}</p>
  </div>

  {% for item in vocabulary %}
  <article class="word-card">
    <div class="word-header">
      <div>
        <span class="number">{{ loop.index }}</span>
        <h2>{{ item.word }}</h2>
      </div>
      {% if item.difficulty %}<span class="badge">{{ item.difficulty }}</span>{% endif %}
    </div>
    <div class="definition"><b>{{ item.meaning }}</b> &middot; {{ item.part_of_speech }}</div>
    <div class="grid">
      <div><span>유의어</span><p>{{ (item.synonyms or [])|join(', ') }}</p></div>
      <div><span>반의어</span><p>{{ (item.antonyms or [])|join(', ') }}</p></div>
      <div><span>파생어</span><p>{{ (item.derivatives or [])|join(', ') }}</p></div>
      <div><span>연어/표현</span><p>{{ (item.collocations or [])|join(', ') }}</p></div>
    </div>
    <div class="sentence"><b>지문 속 예문</b>{{ item.context_sentence }}</div>
    <p class="context"><b>문맥상 의미:</b> {{ item.context_meaning }}</p>
  </article>
  {% endfor %}
</body>
</html>
